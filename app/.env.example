# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.
#
# For local development, run the local Supabase stack from the repo root with
# `npx supabase start` and use the Project URL and keys it prints. For hosted
# environments, use the values from your Supabase project settings and Vercel.

# Supabase project URL (e.g. http://127.0.0.1:54321 locally).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (client-safe) key. Exposed to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret / service-role key. SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by cron and some admin routes (Bearer token).
CRON_SECRET=

# PokemonPriceTracker API key for price sync/import (server only). Optional locally.
POKEMON_PRICE_TRACKER_API_KEY=

# Comma-separated list of emails allowed into the /admin page. Optional.
ADMIN_EMAILS=
