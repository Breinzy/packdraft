# Packdraft environment variables (names only — never commit values)
# Copy this file to .env.local in this directory (app/).

# --- Required: app + Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Required: server jobs (crons, admin, catalog/price writes) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: PokemonPriceTracker provider (server-only) ---
POKEMON_PRICE_TRACKER_API_KEY=

# --- Required: cron + admin import endpoints ---
CRON_SECRET=

# --- Required: admin UI and admin proxy (comma-separated emails) ---
# If unset or empty, no user is treated as an admin.
ADMIN_EMAILS=

# --- Optional: provided by Vercel for self-fetch on the platform ---
# VERCEL_URL=

# --- Optional: credits this process may spend on one catalog-import chunk ---
# PACKDRAFT_IMPORT_CREDIT_BUDGET=2500
